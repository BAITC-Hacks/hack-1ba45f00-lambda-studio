# ИИ-аналитик «Грибницы» — НЕОБЯЗАТЕЛЬНО.
# Без ключа работает всё, кроме живых ответов ИИ: вкладка «ИИ-аналитик» показывает
# сохранённую справку out/brief.md. Для проверки решения ключ не нужен.
#
# Как включить: скопируйте этот файл в .env и впишите ключ.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
# Файл .env не коммитится (.gitignore).

# Ключ OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Быстрая модель с поддержкой function calling (chat completions + tools)
OPENAI_MODEL=gpt-4.1-mini

# Необязательно: свой адрес совместимого API (прокси, Azure-совместимый шлюз). Пусто — api.openai.com
OPENAI_BASE_URL=

# Необязательно: таймаут одного запроса к модели, секунд
OPENAI_TIMEOUT=30
